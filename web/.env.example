VITE_API_URL=http://localhost:8000
# Optional licensed raster tiles supporting {z}/{x}/{y} URL tokens:
# VITE_SATELLITE_TILES_URL=https://your-provider.example/tiles/{z}/{x}/{y}.jpg
# VITE_SATELLITE_ATTRIBUTION=Imagery provider attribution

# Optional glyph URL for map labels. Default is public MapLibre demo glyphs;
# self-host compatible .pbf glyph ranges for reliable offline usage.
# VITE_GLYPHS_URL=https://your-glyph-server/fonts/{fontstack}/{range}.pbf
