{
  "name": "geofathom-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run src --coverage --coverage.reporter=json-summary --coverage.reporter=text --coverage.reporter=html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
