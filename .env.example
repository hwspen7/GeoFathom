# Geospatial services and HTTP interface
GEOFATHOM_CONTACT_EMAIL=
GEOFATHOM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOFATHOM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOFATHOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary model: GPT-OSS 120B on Groq free developer tier
GEOFATHOM_LLM_PROVIDER=groq
GEOFATHOM_LLM_MODEL=openai/gpt-oss-120b
GEOFATHOM_GROQ_API_KEY=

# Optional multimodal model: Gemini 3.8 Flash free tier
GEOFATHOM_ANALYSIS_PROVIDER=gemini
GEOFATHOM_ANALYSIS_MODEL=gemini-3.8-flash
GEOFATHOM_GEMINI_API_KEY=

# Other supported provider options: ollama, openai-compatible, none.
# Set GEOFATHOM_LLM_PROVIDER=ollama and GEOFATHOM_LLM_MODEL to your
# actual local model tag to use local inference instead.
GEOFATHOM_OLLAMA_URL=http://localhost:11434
GEOFATHOM_OPENAI_BASE_URL=http://localhost:8001/v1
GEOFATHOM_OPENAI_API_KEY=
GEOFATHOM_ANALYSIS_BASE_URL=http://localhost:8081/v1
GEOFATHOM_ANALYSIS_OLLAMA_URL=http://localhost:11434

# Persistent project store. Uses data/geofathom.sqlite when omitted.
# GEOFATHOM_DATABASE_PATH=data/geofathom.sqlite

# Optional model manager. Generate a strong random token locally and do not commit it.
GEOFATHOM_MODEL_ADMIN_TOKEN=
# Optional path for persistent user-defined model entries, stored without API keys.
# GEOFATHOM_MODEL_CATALOG_PATH=data/model-catalog.json

# Additional custom provider credentials can be stored in variables with this prefix.
# GEOFATHOM_MODEL_KEY_MY_PROVIDER=


# Secure OGC data sources. Comma-separated trusted public HTTPS hostnames.
# GEOFATHOM_OGC_ALLOW_HOSTS=maps.example.org,features.example.org
# The existing GEOFATHOM_MODEL_ADMIN_TOKEN protects OGC registration, PostGIS
# write/sync operations and powerful background tasks.

# Optional PostgreSQL/PostGIS read-oriented project mirror.
# Install python -m pip install -e ".[dev,postgis]" and configure your database.
# GEOFATHOM_POSTGIS_DSN=postgresql://geofathom:<password>@localhost:5432/geofathom

# Optional server-provisioned ONNX satellite segmentation models.
# Each validated model has a matching <id>.onnx and <id>.json manifest.
# Install python -m pip install -e ".[dev,vision]" for ONNX CPU runtime.
# GEOFATHOM_VISION_MODELS_DIR=data/vision-models
# GEOFATHOM_VISION_DEVICE=cpu

# GeoAI streaming and inference resource controls (optional).
# Maximum per-job image pixels is capped at 64 million in the API.
# GEOFATHOM_VISION_MAX_CACHED_MODELS=2
# GEOFATHOM_VISION_PARALLEL_INFERENCE=2
# GEOFATHOM_VISION_TENSOR_MEMORY_MB=128
# GEOFATHOM_VISION_CPU_THREADS=2
# GEOFATHOM_VISION_GPU_ARENA_MB=2048

# Optional CUDA IO binding. Does not eliminate CPU<->GPU transfers.
# GEOFATHOM_VISION_IO_BINDING=1
# Optional GPU acceptance requires operator-provided model weights.
# GEOFATHOM_GPU_ACCEPTANCE_MODEL=landcover
# Optional million-segment native stress.
# GEOFATHOM_STRESS_MILLION_SEGMENTS=1

# API boundary (default=local; only loopback clients can connect).
# For TLS deployment behind a trusted reverse proxy use both:
# GEOFATHOM_AUTH_MODE=required
# GEOFATHOM_API_TOKEN=at-least-32-random-high-entropy-characters

# Separate local process worker. Use the same SQLite path, not NFS.
# GEOFATHOM_EXTERNAL_WORKER=1
# GEOFATHOM_RASTER_ISOLATE=1
# GEOFATHOM_RASTER_TIMEOUT_SECONDS=900
# GEOFATHOM_RASTER_RSS_MB=2048

# Trusted COG HTTPS asset hosts (no arbitrary remote URL endpoints).
# GEOFATHOM_COG_ALLOWED_HOSTS=e84-earth-search-sentinel-data.s3.us-west-2.amazonaws.com

# Hardware qualification: expected device, not a simulated result.
# GEOFATHOM_GPU_EXPECTED_NAME=4070 Ti SUPER

# Optional native CPU/GPU and artifact management
# GEOFATHOM_SPECTRAL_DEVICE=auto
# GEOFATHOM_CUDA_MIN_PIXELS=262144
# GEOFATHOM_CUDA_SPECTRAL_MAX_PIXELS=1048576
# GEOFATHOM_CPU_CORES_PER_WORKER=0
# GEOFATHOM_RASTER_AS_MB=0
# GEOFATHOM_RASTER_MAX_PIXELS=67108864
# GEOFATHOM_TILE_CACHE_MB=256
# GEOFATHOM_VERSION_DIR=/operator/shared/version-archive
# GEOFATHOM_DISTRIBUTED_DSN=postgresql://user:password@localhost/geofathom
# GEOFATHOM_DISTRIBUTED_QUEUE=default
# GEOFATHOM_REMOTE_ASSET_CACHE_DIR=/operator/cog-cache
# GEOFATHOM_REMOTE_ASSET_MAX_MB=2048

# Aggregate compute worker memory (disabled unless explicitly provisioned).
# GEOFATHOM_WORKER_MEMORY_MB=8192
# GEOFATHOM_WORKER_CGROUP=/sys/fs/cgroup/geofathom-workers
# GEOFATHOM_WORKER_MEMORY_GROUP=geofathom-workers
# GEOFATHOM_CUDA_SPECTRAL_BUDGET_MB=256
# GEOFATHOM_VISION_GPU_TOTAL_MB=8192
# GEOFATHOM_VISION_CPU_TOTAL_MB=4096
# GEOFATHOM_VISION_DEVICE_POSTPROCESS=1
# GEOFATHOM_ALERT_WEBHOOK=https://operator-alert-receiver.example/hook
