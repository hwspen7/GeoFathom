# Geospatial services and HTTP interface
GEOFATHOM_CONTACT_EMAIL=
GEOFATHOM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOFATHOM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOFATHOM_CORS_ORIGINS=http://localhost:5173

# Primary model: GPT-OSS 120B on Groq free developer tier
GEOFATHOM_LLM_PROVIDER=groq
GEOFATHOM_LLM_MODEL=openai/gpt-oss-120b
GEOFATHOM_GROQ_API_KEY=

# Optional multimodal model: Gemini 3.8 Flash free tier
GEOFATHOM_ANALYSIS_PROVIDER=gemini
GEOFATHOM_ANALYSIS_MODEL=gemini-3.8-flash
GEOFATHOM_GEMINI_API_KEY=

# Other supported provider options: ollama, openai-compatible, none.
# Set GEOFATHOM_LLM_PROVIDER=ollama and GEOFATHOM_LLM_MODEL to your
# actual local model tag to use local inference instead.
GEOFATHOM_OLLAMA_URL=http://localhost:11434
GEOFATHOM_OPENAI_BASE_URL=http://localhost:8001/v1
GEOFATHOM_OPENAI_API_KEY=
GEOFATHOM_ANALYSIS_BASE_URL=http://localhost:8081/v1
GEOFATHOM_ANALYSIS_OLLAMA_URL=http://localhost:11434

# Persistent project store. Uses data/geofathom.sqlite when omitted.
# GEOFATHOM_DATABASE_PATH=data/geofathom.sqlite
